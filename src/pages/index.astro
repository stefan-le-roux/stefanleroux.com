---
import LayoutDefault from "../layouts/LayoutDefault.astro";

const title = "Stefan le Roux | Frontend Web Developer & Code Library";
const description =
	"Personal portfolio featuring frontend development work, technical blog posts, code snippets, security audits, and component reviews. Built with Astro and vanilla JavaScript.";
const image = "../assets/images/favicon.svg";
---

<LayoutDefault title={title} description={description} image={image}>
	<section style="display: grid; place-items: center; place-content: center; min-block-size: 80svh;">
		<img src="/images/fox.svg" alt="test" width="200px" style="inline-size: min(500px, 100%);" />
		<h1>Coming Soon</h1>
	</section>
</LayoutDefault>

---
import LayoutDefault from "../layouts/LayoutDefault.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import Soon from "../blocks/soon.astro";

const isVisible = (entry: any) => entry.data.status === "visible";

const [rawBlog, rawAudit, rawRepo] = await Promise.all([
	getCollection("blog"),
	getCollection("audit"),
	getCollection("repo"),
]);

const blogPosts = rawBlog.filter(isVisible);
const auditPosts = rawAudit.filter(isVisible);
const repoPosts = rawRepo.filter(isVisible);

const title = "Stefan le Roux | Code Library – Articles, Snippets & Audits";
const description =
	"Archive of technical articles, code examples, plugin reviews, and security audits for developers working with modern frontend stacks and CMS integrations.";
const image = "../assets/images/favicon.svg";
---

<LayoutDefault title={title} description={description} image={image}>
	<section>
		<hgroup>
			<h1>Welcome to My Library</h1>
			<p>A collection of writing, audits, and code</p>
		</hgroup>
	</section>

	<section>
		<hgroup>
			<h2 id="writings-heading">Blog</h2>
			<p>Reflections on code, craft, and whatever else matters.</p>
		</hgroup>
		{
			blogPosts.length > 0 ? (
				<ul class="posts" role="list">
					{blogPosts.map((post) => (
						<li>
							<article>
								<Image
									src={post.data.image ?? "/assets/images/placeholder.avif"}
									alt={post.data.alt ?? ""}
									width={600}
									height={315}
									format="avif"
									priority
								/>
								<hgroup>
									<h2>
										<a href={`/library/${post.data.slug}/`}>{post.data.title}</a>
									</h2>
									<time datetime={post.data.pubDate.toISOString().split("T")[0]}>
										{post.data.pubDate.toISOString().split("T")[0]}
									</time>
								</hgroup>
								<p>{post.data.description}</p>
							</article>
						</li>
					))}
				</ul>
			) : (
				<Soon />
			)
		}
	</section>

	<section>
		<hgroup>
			<h2 id="audits-heading">Audits</h2>
			<p>From Lighthouse metrics to company culture and process evaluation.</p>
		</hgroup>

		{
			auditPosts.length > 0 ? (
				<ul class="posts" role="list">
					{auditPosts.map((post) => (
						<li>
							<article>
								<Image
									src={post.data.image ?? "/assets/images/placeholder.avif"}
									alt={post.data.alt ?? ""}
									width={600}
									height={315}
									format="avif"
								/>
								<hgroup>
									<h2>
										<a href={`/library/${post.data.slug}/`}>{post.data.title}</a>
									</h2>
									<time datetime={post.data.pubDate.toISOString().split("T")[0]}>
										{post.data.pubDate.toISOString().split("T")[0]}
									</time>
								</hgroup>
								<p>{post.data.description}</p>
							</article>
						</li>
					))}
				</ul>
			) : (
				<Soon />
			)
		}
	</section>

	<section>
		<hgroup>
			<h2 id="snippets-heading">Docs</h2>
			<p>Trials, processes, experiments, small demos, notes.</p>
		</hgroup>

		{
			repoPosts.length > 0 ? (
				<ul class="posts" role="list">
					{repoPosts.map((post) => (
						<li>
							<article>
								<Image
									src={post.data.image ?? "/assets/images/placeholder.avif"}
									alt={post.data.alt ?? ""}
									width={600}
									height={315}
									format="avif"
								/>
								<hgroup>
									<h2>
										<a href={`/library/${post.data.slug}/`}>{post.data.title}</a>
									</h2>
									<time datetime={post.data.pubDate.toISOString().split("T")[0]}>
										{post.data.pubDate.toISOString().split("T")[0]}
									</time>
								</hgroup>
								<p>{post.data.description}</p>
							</article>
						</li>
					))}
				</ul>
			) : (
				<Soon />
			)
		}
	</section>
</LayoutDefault>

<style>
	main {
		display: grid;
		gap: 2em;
	}

	section {
		background: var(--blockColor);
		border-radius: var(--borderRadius);
		border: solid var(--borderWidth) var(--borderColor);
		padding: 1em;
		display: grid;
		gap: 1em;

		&:not(:first-of-type) {
			margin-block-start: 1em;
		}
	}

	.posts {
		display: grid;
		grid: auto / repeat(auto-fill, minmax(min(280px, 100%), 1fr));
		gap: 3rem;
	}

	li {
		position: relative;
		background: oklch(from var(--blockColor) calc(l - 0.015) c h);
		border-radius: var(--borderRadius);
		border: solid var(--borderWidth) var(--borderColor);
		isolation: isolate;

		&:has(a:hover),
		&:focus-within {
			background: oklch(from var(--colorPri) l c h / 0.2);
			border-color: oklch(from var(--colorPri) l c h / 0.5);
		}

		@media (prefers-reduced-motion: no-preference) {
			& {
				transition:
					border-color 0.05s ease-in-out,
					background 0.15s ease-in-out;
			}
		}
	}

	article {
		block-size: 100%;
		display: flex;
		flex-flow: column;
		gap: 2rem;

		& > *:not(img) {
			margin-inline: 2rem;
		}

		&::after {
			margin-inline: 2rem;
			margin-block-end: 2rem;
		}

		h2 {
			font-size: var(--fs-1);
			line-height: 1.1;

			a {
				display: inline-block;
			}

			a::before {
				content: "";
				position: absolute;
				inset: 0;
				z-index: 1;
				outline: inherit;
			}
		}

		img {
			inline-size: 100%;
			aspect-ratio: 1.91 / 1;
			object-fit: cover;
			border-radius: var(--borderRadius) var(--borderRadius) 0 0;
		}

		time {
			font-size: var(--fs-0);
			display: inline-block;
			background: oklch(from var(--colorSuc) l c h / 0.15);
			color: var(--colorSuc);
			border-radius: var(--borderRadius);
			font-variation-settings: "wght" 700;
			padding-inline: 0.3em;
			padding-block: 0.15em;
		}

		p {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 3;
			overflow: hidden;
			font-size: var(--fs-0);
			flex-grow: 1;
		}

		&::after {
			content: "Read More";
			font-size: var(--fs-1);
			padding-inline: var(--paddingGap);
			padding-block: calc(var(--paddingGap) / 1.35);
			background: var(--buttonColor);
			border: var(--buttonBorder);
			border-radius: var(--borderRadius);
			text-align: center;
		}

		&:hover::after,
		&:focus-within::after {
			background: oklch(from var(--colorPri) l c h / 0.5);
			border-color: oklch(from var(--colorPri) l c h / 1);
		}

		@media (prefers-reduced-motion: no-preference) {
			&:hover::after,
			&:focus-within::after {
				transition:
					border-color 0.05s ease-in-out,
					background 0.15s ease-in-out;
			}
		}
	}
</style>
